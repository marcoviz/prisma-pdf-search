# Preencha sua chave localmente. Nunca versione .env.
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_CHAT_MODEL=gemini-3.1-flash-lite
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=prisma_pdf
PDF_PATH=document.pdf
# Lotes menores e intervalo reduzem rajadas na cota gratuita de embeddings.
INGEST_BATCH_SIZE=16
INGEST_BATCH_DELAY_SECONDS=30
LANGSMITH_TRACING=false
